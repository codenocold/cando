--cpu Cortex-M3
"usb-can\startup_stm32f105xc.o"
"usb-can\main.o"
"usb-can\can.o"
"usb-can\led.o"
"usb-can\queue.o"
"usb-can\util.o"
"usb-can\usbd_gs_can.o"
"usb-can\usbd_conf.o"
"usb-can\usbd_desc.o"
"usb-can\stm32f1xx_it.o"
"usb-can\stm32f1xx_hal_msp.o"
"usb-can\stm32f1xx_hal_gpio_ex.o"
"usb-can\stm32f1xx_hal_pcd.o"
"usb-can\stm32f1xx_hal_pcd_ex.o"
"usb-can\stm32f1xx_ll_usb.o"
"usb-can\stm32f1xx_hal.o"
"usb-can\stm32f1xx_hal_rcc.o"
"usb-can\stm32f1xx_hal_rcc_ex.o"
"usb-can\stm32f1xx_hal_gpio.o"
"usb-can\stm32f1xx_hal_dma.o"
"usb-can\stm32f1xx_hal_cortex.o"
"usb-can\stm32f1xx_hal_pwr.o"
"usb-can\stm32f1xx_hal_flash.o"
"usb-can\stm32f1xx_hal_flash_ex.o"
"usb-can\stm32f1xx_hal_exti.o"
"usb-can\stm32f1xx_hal_can.o"
"usb-can\stm32f1xx_hal_tim.o"
"usb-can\stm32f1xx_hal_tim_ex.o"
"usb-can\system_stm32f1xx.o"
"usb-can\usbd_core.o"
"usb-can\usbd_ctlreq.o"
"usb-can\usbd_ioreq.o"
--library_type=microlib --strict --scatter "usb-can\usb-can.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "usb-can.map" -o usb-can\usb-can.axf